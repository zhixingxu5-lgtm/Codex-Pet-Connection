{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Pet Link",
  "version": "0.1.0",
  "identifier": "com.codexpetlink.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex Pet Link",
        "width": 840,
        "height": 760,
        "minWidth": 620,
        "minHeight": 600,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A private two-person Codex desktop pet.",
    "longDescription": "Codex Pet Link displays your pet and one friend's pet, synchronized from privacy-filtered Codex task states.",
    "resources": {
      "../../../integrations/codex-marketplace": "codex-marketplace"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
